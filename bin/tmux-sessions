#!/usr/bin/env bash
# tmux-sessions — backend for the io.github.cache21.tmux-sessions plugin.
#
#   tmux-sessions list             one line per session, TAB-separated fields:
#                                  name, windows, clients, created, activity, path
#   tmux-sessions attach <name>    resume the session: if it is already attached in
#                                  some terminal, focus it; otherwise open a new one
#   tmux-sessions kill <name>      kill the session
#   tmux-sessions preview <name>   window list + contents of the active pane
#
# Optional env: TS_TERM_APP_ID (terminal app-id, default tmux-session).

set -uo pipefail

TAB=$'\t'

die() { printf '%s\n' "$*" >&2; exit 1; }

need_name() { [ -n "${1:-}" ] || die "missing session name"; }

cmd_list() {
  tmux list-sessions -F "#{session_name}${TAB}#{session_windows}${TAB}#{session_attached}${TAB}#{session_created}${TAB}#{session_activity}${TAB}#{pane_current_path}" 2>/dev/null || true
}

# Walk up a PID's parent chain until one owns a Hyprland window (the terminal
# the tmux client runs in).
window_pid_for() {
  local pid="$1" wins
  wins="$(hyprctl clients -j 2>/dev/null | jq -r '.[].pid' 2>/dev/null)" || return 1
  [ -n "$wins" ] || return 1
  while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
    if printf '%s\n' "$wins" | grep -qxF "$pid"; then
      printf '%s\n' "$pid"
      return 0
    fi
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
  done
  return 1
}

focus_pid() {
  local target="pid:$1"
  hyprctl dispatch "hl.dsp.focus({ window = \"$target\" })" >/dev/null 2>&1 \
    || hyprctl dispatch focuswindow "$target" >/dev/null 2>&1
}

cmd_attach() {
  need_name "${1:-}"
  local name="$1" cpid wpid
  tmux has-session -t "=$name" 2>/dev/null || die "no such session: $name"

  # Already attached in some terminal? Focus it instead of opening a second client.
  while read -r cpid; do
    [ -n "$cpid" ] || continue
    if wpid="$(window_pid_for "$cpid")"; then
      focus_pid "$wpid" && exit 0
    fi
  done < <(tmux list-clients -t "=$name" -F '#{client_pid}' 2>/dev/null)

  local app_id="${TS_TERM_APP_ID:-tmux-session}"
  if command -v omarchy-launch-tui >/dev/null 2>&1; then
    exec omarchy-launch-tui --app-id="$app_id" tmux attach-session -t "=$name"
  elif [ -n "${TERMINAL:-}" ]; then
    exec "$TERMINAL" -e tmux attach-session -t "=$name"
  else
    exec xdg-terminal-exec tmux attach-session -t "=$name"
  fi
}

cmd_kill() {
  need_name "${1:-}"
  tmux kill-session -t "=$1" 2>/dev/null || die "could not kill: $1"
}

cmd_preview() {
  need_name "${1:-}"
  local name="$1"
  tmux has-session -t "=$name" 2>/dev/null || exit 0
  tmux list-windows -t "=$name" \
    -F '#{?window_active,▸, } #{window_index}: #{window_name}  (#{window_panes} pane#{?#{==:#{window_panes},1},,s})' 2>/dev/null
  printf '\n'
  # Last non-empty lines of the active pane, without the trailing blank padding.
  tmux capture-pane -p -J -t "=$name:" 2>/dev/null \
    | sed -e 's/[[:space:]]*$//' \
    | awk 'NF { last = NR } { line[NR] = $0 } END { s = last - 40; if (s < 1) s = 1; for (i = s; i <= last; i++) print line[i] }'
}

case "${1:-}" in
  list)    cmd_list ;;
  attach)  shift; cmd_attach "$@" ;;
  kill)    shift; cmd_kill "$@" ;;
  preview) shift; cmd_preview "$@" ;;
  *) die "usage: tmux-sessions {list|attach <name>|kill <name>|preview <name>}" ;;
esac
